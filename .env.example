# Copy to .env (chmod 600). Never commit the real file.

# Paperless stack
POSTGRES_PASSWORD=<strong random password>
PAPERLESS_SECRET_KEY=<openssl rand -hex 32>
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=<strong password>

# OneWelcome Access – Paperless-ngx OIDC client
PAPERLESS_CLIENT_ID=<Paperless-ngx client id>
PAPERLESS_OIDC_CLIENT_SECRET=<Paperless-ngx client secret>

# claims-hook
HOOK_SECRET=<openssl rand -hex 24>
DM_CLIENT_ID=<client-credentials client id (correlation:user:get, correlation:organization:get)>
DM_CLIENT_SECRET=<its secret>
PAPERLESS_TOKEN=<API token of a dedicated Paperless "provisioner" superuser>
